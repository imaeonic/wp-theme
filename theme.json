{
  "$schema": "https://schemas.wp.org/wp/7.1/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "color": {
      "custom": true,
      "customGradient": true,
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        { "slug": "ink", "name": "Ink", "color": "#071421" },
        { "slug": "navy", "name": "Navy", "color": "#10243A" },
        { "slug": "blue", "name": "Rismor Blue", "color": "#0879F9" },
        { "slug": "cyan", "name": "Rismor Cyan", "color": "#00BDEB" },
        { "slug": "slate", "name": "Slate", "color": "#66758A" },
        { "slug": "mist", "name": "Mist", "color": "#F3F6F9" },
        { "slug": "white", "name": "White", "color": "#FFFFFF" }
      ],
      "gradients": [
        {
          "slug": "rismor-flow",
          "name": "Rismor Flow",
          "gradient": "linear-gradient(135deg, #0879F9 0%, #00BDEB 100%)"
        },
        {
          "slug": "deep-tech",
          "name": "Deep Tech",
          "gradient": "linear-gradient(135deg, #071421 0%, #10243A 100%)"
        }
      ]
    },
    "layout": {
      "contentSize": "760px",
      "wideSize": "1440px"
    },
    "lightbox": {
      "enabled": true,
      "allowEditing": true
    },
    "position": {
      "sticky": true
    },
    "shadow": {
      "defaultPresets": false,
      "presets": [
        { "slug": "soft", "name": "Soft", "shadow": "0 18px 60px rgba(7,20,33,0.10)" },
        { "slug": "lift", "name": "Lift", "shadow": "0 28px 90px rgba(7,20,33,0.16)" }
      ]
    },
    "spacing": {
      "blockGap": true,
      "margin": true,
      "padding": true,
      "units": ["px", "rem", "em", "%", "vw", "vh"],
      "spacingSizes": [
        { "slug": "10", "name": "2XS", "size": "0.5rem" },
        { "slug": "20", "name": "XS", "size": "0.75rem" },
        { "slug": "30", "name": "S", "size": "1rem" },
        { "slug": "40", "name": "M", "size": "1.5rem" },
        { "slug": "50", "name": "L", "size": "2.5rem" },
        { "slug": "60", "name": "XL", "size": "4rem" },
        { "slug": "70", "name": "2XL", "size": "6rem" },
        { "slug": "80", "name": "3XL", "size": "9rem" }
      ]
    },
    "typography": {
      "customFontSize": true,
      "fluid": true,
      "fontStyle": true,
      "fontWeight": true,
      "letterSpacing": true,
      "lineHeight": true,
      "textDecoration": true,
      "textTransform": true,
      "fontFamilies": [
        {
          "slug": "system",
          "name": "System Sans",
          "fontFamily": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif"
        },
        {
          "slug": "editorial",
          "name": "Editorial Sans",
          "fontFamily": "Arial, Helvetica, sans-serif"
        }
      ],
      "fontSizes": [
        { "slug": "xs", "name": "XS", "size": "0.8rem" },
        { "slug": "sm", "name": "Small", "size": "0.95rem" },
        { "slug": "md", "name": "Body", "size": "1.08rem" },
        { "slug": "lg", "name": "Lead", "size": "1.3rem" },
        { "slug": "xl", "name": "H4", "size": "1.65rem" },
        { "slug": "2xl", "name": "H3", "size": "2.2rem" },
        { "slug": "3xl", "name": "H2", "size": "3.2rem" },
        { "slug": "4xl", "name": "Display", "size": "clamp(3.4rem, 7vw, 7.5rem)" }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|white",
      "text": "var:preset|color|ink"
    },
    "spacing": {
      "blockGap": "var:preset|spacing|40",
      "padding": {
        "left": "clamp(1.25rem, 3vw, 3rem)",
        "right": "clamp(1.25rem, 3vw, 3rem)"
      }
    },
    "typography": {
      "fontFamily": "var:preset|font-family|system",
      "fontSize": "var:preset|font-size|md",
      "lineHeight": "1.65"
    },
    "elements": {
      "button": {
        "border": {
          "radius": "4px",
          "width": "1px"
        },
        "color": {
          "background": "var:preset|color|ink",
          "text": "var:preset|color|white"
        },
        "spacing": {
          "padding": {
            "top": "0.9rem",
            "right": "1.25rem",
            "bottom": "0.9rem",
            "left": "1.25rem"
          }
        },
        "typography": {
          "fontSize": "var:preset|font-size|sm",
          "fontWeight": "650",
          "letterSpacing": "0.01em"
        }
      },
      "heading": {
        "color": { "text": "var:preset|color|ink" },
        "typography": {
          "fontFamily": "var:preset|font-family|system",
          "fontWeight": "650",
          "letterSpacing": "-0.035em",
          "lineHeight": "1.03"
        }
      },
      "link": {
        "color": { "text": "var:preset|color|blue" },
        "typography": { "textDecoration": "underline" }
      }
    },
    "blocks": {
      "core/navigation": {
        "typography": {
          "fontSize": "var:preset|font-size|sm",
          "fontWeight": "600"
        }
      },
      "core/paragraph": {
        "typography": { "lineHeight": "1.7" }
      },
      "core/post-content": {
        "spacing": { "blockGap": "var:preset|spacing|40" }
      },
      "core/quote": {
        "border": {
          "left": {
            "color": "var:preset|color|cyan",
            "style": "solid",
            "width": "3px"
          }
        },
        "spacing": {
          "padding": { "left": "var:preset|spacing|40" }
        }
      }
    }
  },
  "customTemplates": [
    { "name": "landing", "title": "Landing Page", "postTypes": ["page"] },
    { "name": "blank", "title": "Blank Canvas", "postTypes": ["page"] },
    { "name": "sidebar", "title": "Page with Sidebar", "postTypes": ["page"] }
  ],
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ]
}
